<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- APK distribué hors Play Store (cf. bannière de mise à jour, UpdatePrompt.tsx) : sans cette
         permission, le Gestionnaire de paquets refuse l'installation déclenchée par notre appli
         (« needs to declare permission android.permission.REQUEST_INSTALL_PACKAGES », constaté via
         adb logcat) — l'écran d'installation ne s'ouvre jamais, silencieusement. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Localisation en arrière-plan : le plugin background-geolocation ne déclare que
         ACCESS_FINE/COARSE_LOCATION. Sans ACCESS_BACKGROUND_LOCATION (« Autoriser tout le
         temps »), Android 10+ étrangle la localisation à quelques relevés par heure dès que
         l'appli passe en arrière-plan, même avec un foreground service de type location —
         l'enregistrement direct produisait alors un tracé réduit à quelques points. Le plugin
         est patché (voir patches/) pour demander cette permission au démarrage du suivi. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
</manifest>
