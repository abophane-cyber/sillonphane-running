# Configuration Apache (OVH). Copié tel quel dans dist/ par Vite.

# HTTPS obligatoire + domaine sans www
RewriteEngine On
# La validation Let's Encrypt (renouvellement du certificat) se fait en HTTP : ne pas la rediriger
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^sillonphane\.fr$ [NC]
RewriteRule ^ https://sillonphane.fr%{REQUEST_URI} [L,R=301]

# Types MIME
AddType application/vnd.android.package-archive .apk
AddType model/gltf-binary .glb
AddType video/mp4 .mp4
AddType application/manifest+json .webmanifest
AddType application/javascript .js .mjs

# APK : téléchargé, jamais affiché
<FilesMatch "\.apk$">
  Header set Content-Disposition "attachment"
</FilesMatch>

# Cache : assets hachés par Vite = immuables ; pages, service worker et manifeste = toujours revalidés
# (indispensable pour que la PWA « autoUpdate » voie les nouvelles versions)
<IfModule mod_headers.c>
  # Pas de revalidation par date : le déploiement (deploy-ovh.yml) fixe la date de chaque fichier
  # d'après son sha1, soit une date AU HASARD entre 1970 et 1978. Une nouvelle version pouvait donc
  # être « plus ancienne » que la copie en cache du navigateur -> 304 « pas modifié » -> sw.js et
  # app.html restaient bloqués sur l'ancienne version (~1 déploiement sur 2 invisible). On retire
  # ces dates des réponses et on ignore celles envoyées par les navigateurs (caches existants) :
  # un fichier « no-cache » est toujours renvoyé en entier (quelques Ko).
  RequestHeader unset If-Modified-Since
  RequestHeader unset If-Unmodified-Since
  RequestHeader unset If-Range
  Header unset Last-Modified

  <FilesMatch "\.(html|webmanifest)$|^(sw|workbox-.*)\.js$|^(version|promo)\.json$|^sitemap\.xml$|^robots\.txt$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/rando/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|woff2|mp3|mp4|glb)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # version.json et l'APK sont lus en cross-origin par l'APK (WebView, origine locale) : le premier
  # pour la bannière de mise à jour, le second désormais aussi via fetch() (UpdatePrompt.tsx) pour
  # l'écrire dans le cache de l'appli puis l'ouvrir avec FileOpener.
  # promo.json (codes promo imprimeurs) est lu de la même façon par l'offre d'impression.
  <FilesMatch "^(version|promo)\.json$|\.apk$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
