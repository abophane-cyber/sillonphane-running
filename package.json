{
  "name": "sillonphane-running",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:cap": "tsc -b && vite build --mode capacitor",
    "lint": "eslint .",
    "preview": "vite preview",
    "record": "node scripts/record.mjs",
    "record:prod": "node scripts/record.mjs https://sillonphane.fr/running",
    "og": "node scripts/og-shot.mjs",
    "apk:publish": "node scripts/apk-publish.mjs",
    "android:sync": "npm run build:cap && node -e \"const fs=require('fs'); fs.copyFileSync('dist/app.html','dist/index.html'); fs.rmSync('dist/downloads', { recursive: true, force: true })\" && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "android:play": "node scripts/android-play.mjs",
    "postinstall": "node -e \"if(!process.env.VERCEL) require('child_process').execSync('patch-package', { stdio: 'inherit' })\""
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "gifuct-js": "^2.1.2",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "maplibre-gl": "^5.24.0",
    "mp4-muxer": "^5.2.2",
    "mp4box": "^2.4.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "togeojson": "^0.16.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.6.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "three": "^0.185.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
